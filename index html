<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Online</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">Toko<span>Online</span></div>
        <nav>
            <ul>
                <li><a href="#">Beranda</a></li>
                <li><a href="#">Produk</a></li>
                <li><a href="#">Tentang</a></li>
                <li><a href="#">Kontak</a></li>
            </ul>
        </nav>
    </header>

    <!-- Banner -->
    <section class="banner">
        <h1>Selamat Datang di Toko Online</h1>
        <p>Belanja mudah dan cepat dengan harga terbaik!</p>
        <button>Belanja Sekarang</button>
    </section>

    <!-- Produk -->
    <section class="produk-section">
        <h2>Produk Kami</h2>
        <div class="produk-container">

            <div class="produk-card">
                <img src="https://via.placeholder.com/200" alt="Produk 1">
                <h3>Produk 1</h3>
                <p>Rp 150.000</p>
                <button>Tambah ke Keranjang</button>
            </div>

            <div class="produk-card">
                <img src="https://via.placeholder.com/200" alt="Produk 2">
                <h3>Produk 2</h3>
                <p>Rp 200.000</p>
                <button>Tambah ke Keranjang</button>
            </div>

            <div class="produk-card">
                <img src="https://via.placeholder.com/200" alt="Produk 3">
                <h3>Produk 3</h3>
                <p>Rp 250.000</p>
                <button>Tambah ke Keranjang</button>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2025 Toko Online. Semua Hak Dilindungi.</p>
    </footer>

</body>
</html>
